# App
ENVIRONMENT=development

# Production only (docker-compose.prod.yml)
DOMAIN=api.taskam.example.com
POSTGRES_PASSWORD=change-me-strong-password

# Database
DATABASE_URL=postgresql+psycopg://taskam:taskam@db:5432/taskam

# Redis
REDIS_URL=redis://redis:6379/0
JOB_MAX_ATTEMPTS=5
JOB_RETRY_BASE_SECONDS=5
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=8
WEBHOOK_RATE_LIMIT=300
WEBHOOK_RATE_WINDOW_SECONDS=60

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# WhatsApp Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v20.0

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OPay (sandbox)
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=
OPAY_MERCHANT_ID=
OPAY_WEBHOOK_SECRET=
OPAY_BASE_URL=https://sandboxapi.opaycheckout.com

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co

# OPAY or PAYSTACK — used when a merchant doesn't specify a provider
DEFAULT_PAYMENT_PROVIDER=OPAY
PAYMENT_SETTLEMENT_ENABLED=false

# SMTP email delivery (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SENTRY_DSN=

# FarmSense service-to-service integration
FARMSENSE_INBOUND_SECRET=
FARMSENSE_OUTBOUND_SECRET=
FARMSENSE_STATUS_WEBHOOK_URL=
SERVICE_AUTH_MAX_SKEW_SECONDS=300
OUTBOUND_WEBHOOK_POLL_SECONDS=5
OUTBOUND_WEBHOOK_MAX_ATTEMPTS=10
LOGISTICS_SERVICE_URL=
LOGISTICS_SERVICE_SECRET=
LOGISTICS_WEBHOOK_SECRET=
TASKAM_SERVICE_IDENTITY=taskam
ALLOW_LEGACY_FARMSENSE_AUTH=false

# Production database backups
BACKUP_RETENTION_DAYS=14

# Object storage (Cloudflare R2 / S3-compatible)
STORAGE_ENDPOINT_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=taskam-files
STORAGE_REGION=auto
STORAGE_PUBLIC_BASE_URL=
PRESIGNED_URL_EXPIRY=900
